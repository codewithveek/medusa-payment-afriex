link-workspace-packages=true

# Medusa's admin bundler resolves @medusajs/dashboard and each plugin's /admin
# entry from the app's own node_modules. pnpm's strict layout hides those
# transitives, so hoist just those rather than reaching for shamefully-hoist.
# React is deliberately NOT hoisted: the Medusa admin is on React 18 and the
# storefront is on React 19, and each workspace declares its own.
public-hoist-pattern[]=@medusajs/*
