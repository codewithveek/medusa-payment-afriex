{
  "name": "@afriex/medusa-payment-monorepo",
  "private": true,
  "description": "Monorepo for the Afriex Medusa payment provider and its example apps.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "plugin:build": "pnpm --filter medusa-payment-afriex run build",
    "plugin:dev": "pnpm --filter medusa-payment-afriex run dev",
    "backend:dev": "pnpm --filter @afriex/example-medusa-backend run dev",
    "storefront:dev": "pnpm --filter @afriex/example-storefront run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build --filter \"./packages/*\" && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.3"
  }
}
