# Where the example Medusa backend is listening
MEDUSA_BACKEND_URL=http://localhost:9000

# Printed by `pnpm seed` in examples/medusa-backend — use that one, not the
# "Default Sales Channel" key Medusa creates on first boot. Only the seeded key
# is linked to the sales channel the example product is published in.
MEDUSA_PUBLISHABLE_KEY=
