# Medusa
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-afriex-example
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8000,http://localhost:3000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Afriex — all three are required, the provider refuses to start without them.
# The API key and the public key must come from the same environment.
AFRIEX_API_KEY=
# The whole PEM on one line, \n where the line breaks were, in double quotes:
#   "-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# For local testing without Afriex, `pnpm webhook:keygen` (repo root) prints a
# throwaway key in this exact form.
AFRIEX_WEBHOOK_PUBLIC_KEY=
# "staging" or "production". Virtual accounts can only be created in production.
AFRIEX_ENVIRONMENT=staging
AFRIEX_DEFAULT_COUNTRY=NG
# Afriex hosted checkout: where Afriex sends the shopper back to. Must be HTTPS
# — for local work, a tunnel to the storefront. {order_id} is replaced with the
# order's id. Leave empty to offer bank transfer only.
AFRIEX_CHECKOUT_RETURN_URL=
# Other storefront origins a return URL may point at, comma-separated.
AFRIEX_CHECKOUT_ALLOWED_RETURN_ORIGINS=
